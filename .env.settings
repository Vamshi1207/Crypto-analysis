# Tracked paper/trading knobs. Commit this file.
# Secrets stay in gitignored .env (NVIDIA_KEY, GEMINI_API_KEY, HELIUS_API_KEY,
# SOLANA_RPC_URL, BIRDEYE_API_KEY). Docker loads .env.settings then .env.
# Do not put API keys or RPC URLs here.

# --- Ports ---
# Host port for python server on your Mac
HOST_PORT=8080

# Internal container port for python server
CONTAINER_PORT=8000

# Host port for Jupyter Notebook on your Mac
JUPYTER_PORT=8888

# --- LLM providers (keys in .env) ---
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
AGY_MODEL=gemini-3.1-pro-high

# --- Safety gate thresholds ---
SAFETY_MIN_LIQUIDITY_USD=5000
SAFETY_MAX_TOP10_PCT=55
SAFETY_MIN_POOL_AGE_MIN=5

# --- Execution cost model (shared by Gate 2 and paper fills) ---
# Slippage is the whole ballgame: at 1.5/1.0 a $1 target on $40 needs a 5.7%
# move in minutes, which almost never prints, so nothing ever trades. Jupiter's
# measured impact on small clips in $8k+ pools is well under 1%, and entry slip
# is replaced by that measurement whenever a quote is available — these are the
# fallbacks, so they should be realistic rather than punitive.
EXEC_ENTRY_FEE_PCT=0.3
EXEC_EXIT_FEE_PCT=0.3
EXEC_ENTRY_SLIP_PCT=0.6
EXEC_EXIT_SLIP_PCT=0.4
EXEC_PRIORITY_TIP_PCT=0.1

# --- Risk committee (Gate 3) ---
VIBE_BLOWOFF_RETURN_PCT=50
VIBE_EXTENDED_RETURN_PCT=20
VIBE_MIN_AGREEMENT=0.35

# --- JEV System One chair (Gate 3, FULL/DEEP) ---
# 1 = typed JEV chair with guards. 0 = heuristic desk only (safe).
# Native TypeSafe (TYPESAFE_API_KEY in gitignored .env, funded account).
# Zen proxy remains a fallback: key order is TYPESAFE → JEV → JEVX →
# OPENCODE, so set JEV_ENDPOINT back to the Zen URL to use it instead.
# Guards preserved: veto→avoid, never upgrades avoid/hold→buy,
# low-confidence buy→hold. Missing key/credits degrades to heuristic,
# never retries hard.
JEV_ENABLED=1
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_S=8
JEV_MIN_CONFIDENCE=0.55
JEV_VETO_THRESHOLD=0.70

# --- Paper AutoHedge ---
# Take more paper trades so we see the real drawdown. Ignored if LIVE_TRADING=1.
PAPER_RISK_ON=1
# 0 = off / unlimited — entries follow decide analysis, not timers/quotas.
PAPER_REENTRY_COOLDOWN_SEC=0
# How stop exits fill when price gaps through the stop.
# barrier = pretend you sold at exactly -$1.60 (too kind vs live).
# mark    = sell at the real print, like a market stop. Use this for a
#           honest practice book. PAPER_MAX_LOSS_PCT still caps a $0 glitch.
PAPER_STOP_FILL_MODE=mark
# Cap on one lot if the print gaps to near-zero (ghost wick). 0 = honest (book
# the full mark, rug and all). Set 1–99 to cap a stop-out gap at that fraction
# of size. With RUG_CONFIRM_ENABLED=1 the cap is *smart*: a gapped mark that is
# positively confirmed as a real on-chain dump (Helius sells or Gecko agreement)
# still books the full loss — only unconfirmed ghost wicks get capped.
PAPER_MAX_LOSS_PCT=60
# Confirmed-rug detector on the stop path: distinguish a ghost wick (cap) from a
# real dump (book full mark). Fail-closed — no signal caps, never books a full
# loss on evidence we could not obtain.
RUG_CONFIRM_ENABLED=1
RUG_CONFIRM_WINDOW_SEC=120
RUG_CONFIRM_MIN_SELLS=1
RUG_CONFIRM_TOL_PCT=5
# On-chain latency fill sim: decide at seen mid, fill later at worst mid in window.
EXEC_SIM_ENABLED=1
EXEC_SIM_LATENCY_SEC=1.5
EXEC_SIM_WORST_FILL=1
EXEC_SIM_BUFFER_SEC=45
# Flat adverse-selection adder on top of the worst mid (basis points). Models
# residual sandwich/priority-race cost beyond the observed window. Lower-bound
# proxy only — real MEV/JITO is usually worse. 0 = worst-mid only.
EXEC_SIM_ADVERSE_BPS=5
PAPER_MAX_TRADES_PER_MINT_DAY=0
PAPER_MAX_NOTIONAL_PER_MINT_DAY=0
PAPER_MAX_DAILY_LOSS_PER_MINT=12
PAPER_ALLOW_ADD_ON=1
PAPER_MAX_OPEN_LOTS_PER_ADDRESS=2
PAPER_BLOCK_ADD_ON_IF_OPEN_LOSING=1
PAPER_BLOCK_REPEAT_MINT_AFTER_STOP=0

# --- Position sizing / barriers ---
# Required move to bank the $1 target is (target/size + round-trip cost). At
# $40 that is 5.7%; at $150 with the cost model above it is ~2.4%, which
# memecoins print regularly. Size is the cheapest lever on tradability.
DECIDE_SCALP_SIZE_USD=150
DECIDE_TARGET_PROFIT_USD=1.0
PAPER_MAX_OPEN=10
PAPER_MAX_NOTIONAL_USD=900
# Cluster-only: stop default unused when CLUSTER_STOP_USD is set.
PAPER_STOP_LOSS_PCT=4.0
# Confidence scales size down; this floor stops it undoing the sizing above.
# At 0.75 a typical 0.35-confidence card still gets ~$112 rather than ~$49.
DECIDE_MIN_SIZE_FRACTION=0.75
# Arm later / wider giveback so runners reach max_hold (where +EV lived).
PAPER_TRAIL_ENABLED=1
PAPER_TRAIL_ARM_USD=3.0
# Tighter giveback banks winners closer to peak: trails gave back 54% of
# peak across 15 TPs (e.g. $43 of $69). The peak fraction (35%) binds on
# real runners; the size fraction covers small peaks. 1.0 exits on a
# smaller retrace.
PAPER_TRAIL_GIVEBACK_PCT=1.0
PAPER_TRAIL_GIVEBACK_OF_PEAK=0.20
# Partial scale-out at arm: bank half at the arm print, trail the rest
# instead of all-or-nothing exits. 0 = classic behavior.
PAPER_TRAIL_PARTIAL_PCT=50
PAPER_TRAIL_PARTIAL_AT_MULT=1.0
# Per-symbol cooldown after any close: copycat tickers re-list as fresh
# mints, which the mint-level block cannot see. 0 = off.
PAPER_SYMBOL_COOLDOWN_SEC=7200
# Ranked rotation: a refused entry at the open cap may displace the
# weakest losing lot. 0 = refuse at cap.
PAPER_ROTATION=1

# --- Scalp decide (Gate 2 paper uses 55% of $1 target until live) ---
PAPER_GATE2_EDGE_FRACTION=0.55
# Floor on cost-adjusted edge. Lowered from 0.5 to 0.1 for high-volume free tier practice.
DECIDE_MIN_EDGE_PCT=0.1

# --- Momentum entry (tape-based path around the forecast median) ---
MOMENTUM_ENTRY=1
MOMENTUM_THRUST_BARS=3
MOMENTUM_RANGE_BARS=20
MOMENTUM_MIN_THRUST_PCT=0.8
MOMENTUM_MIN_BREAKOUT_PCT=0.05
MOMENTUM_MIN_VOLUME_RATIO=1.15
MOMENTUM_MIN_BUY_SELL_RATIO=1.05
MOMENTUM_MAX_EXTENSION_PCT=25
MOMENTUM_MIN_SCORE=0.20

# --- Self-built candle feed (batched DexScreener prices) ---
# On for exec-sim: second-scale mids feed the buy/sell latency window.
PRICEFEED_ENABLED=1
PRICEFEED_TICK_SEC=2
PRICEFEED_MAX_SAMPLES=720
PRICEFEED_MAX_TRACKED=80
PRICEFEED_BACKOFF_SEC=30

# --- Headless discovery ---
# Off for cluster-only (no forecast scalp roster this run).
DISCOVER_ENABLED=0
DISCOVER_INTERVAL_SEC=120
DISCOVER_MAX_CANDIDATES=36
DISCOVER_MAX_OBSERVE=40
DISCOVER_MIN_LIQUIDITY_USD=8000
DISCOVER_MIN_VOLUME_24H_USD=10000
DISCOVER_MIN_AGE_MIN=2
DISCOVER_MAX_AGE_DAYS=30
DISCOVER_NO_EDGE_STREAK=2
# 0 = never time-park; keep re-checking when analysis might flip
DISCOVER_NO_EDGE_COOLDOWN_SEC=0
DISCOVER_EXPLORE_MULTIPLIER=6
# Extra Gecko pool listings beyond trending — new_pools is where memecoin moves
# start, and one feed alone left the roster far too narrow to get a sample.
DISCOVER_GECKO_FEEDS=new_pools,pools
DISCOVER_PRICEFEED_MIN_BARS=12

# --- Decision swarm (continuous decide → paper) ---
SWARM_ENABLED=0
SWARM_INTERVAL_SEC=60
SWARM_MODE=fast
SWARM_DECIDE_OBSERVE=1
SWARM_RUN_SAFETY=0

# --- Paper cross-pool arb ---
ARB_ENABLED=0
ARB_INTERVAL_SEC=30
ARB_MIN_EDGE_PCT=0.05
# Dex mids are a screen. The fill is Jupiter SOL→mint→SOL (circular), hops allowed.
ARB_PREFILTER_MODE=jupiter
ARB_SCREEN_GROSS_PCT=0.3
ARB_MIN_POOL_LIQ_USD=8000
ARB_SIZE_USD=40
ARB_MIN_SIZE_USD=10
ARB_MAX_POOL_FRAC=0.005
ARB_MAX_PER_TICK=3
# 0 = off — re-enter whenever stress/Jupiter analysis still clears
ARB_MINT_COOLDOWN_SEC=0
ARB_MAX_FILLS_PER_MINT_DAY=0
# JEV veto-only gate on verified fills (1 = trap danger vetoes the fill;
# computed edge is never second-guessed; 0 = fill whatever verifies).
JEV_ARB_GATE=1
JEV_ARB_RECHECK_SEC=300
ARB_REQUIRE_CROSS_DEX=0
ARB_STRESS_GAP_FRAC=0.5
ARB_SLIP_PCT=0
ARB_REQUIRE_JUPITER=1
ARB_REQUIRE_BUY_ROUTE=1
ARB_MAX_JUPITER_IMPACT_PCT=8
ARB_JUPITER_IMPACT_LEGS=2
ARB_SOL_USD_FALLBACK=140
# Single source of truth for SOL/USD fallback (arb + trenches). The
# ARB_-prefixed name above is a deprecated alias; prefer this one.
SOL_USD_FALLBACK=140
ARB_CIRCULAR=1
ARB_MAX_CIRCULAR_PER_TICK=4
ARB_JUPITER_GAP_SEC=0.4
ARB_RESTRICT_INTERMEDIATE=0

# --- Live readiness bars (paper must clear before LIVE_TRADING) ---
READY_MIN_SCALP_CLOSES=50
READY_MIN_ARB_FILLS=30
READY_MIN_DECISIONS=200
READY_MIN_SCOREBOARD_N=30
READY_MIN_SCALP_EV_USD=0
READY_MIN_ARB_EV_USD=0
READY_MIN_COVERAGE=0.55
READY_MAX_MAE=8

# --- Indicator alignment (after Gate 2) ---
INDICATOR_GATE=0
INDICATOR_MIN_BUY_SCORE=-0.15
INDICATOR_HARD_BLOCK_SCORE=-0.45

# --- Pipeline observability ---
PIPELINE_LOG_JSONL=1
PIPELINE_LOG_CONSOLE=1
PIPELINE_LOG_LEVEL=INFO
PIPELINE_LOG_HOLDS=0

# Parallel paper books: same tape, isolated cash, different rules.
LABS_ENABLED=1

# --- Launch + smart-money cluster (paper) ---
# v3: opposite of v2 — scratch dead tape fast, tight stop, require Dex m5 lift.
# v2 wider stops made early losers more expensive; 6m+ survivors stayed +EV.
LAUNCH_ENABLED=0
CLUSTER_ENABLED=1
TRENCHES_INTERVAL_SEC=15
LAUNCH_MAX_AGE_MIN=10
LAUNCH_MIN_LIQ_USD=15000
LAUNCH_MIN_BUYERS=2
LAUNCH_SIZE_USD=80
LAUNCH_MAX_HOLD_SEC=180
TRENCHES_MAX_PRICE_DIVERGE_PCT=8
CLUSTER_MIN_WALLETS=12
# Refuse parabolic blowoffs: m5>150% entries averaged -$16.4/trade
# over 118 closes (instant rugs). 0 = off.
CLUSTER_MAX_M5_PCT=150
CLUSTER_WINDOW_SEC=120
CLUSTER_SIZE_USD=40
CLUSTER_MAX_HOLD_SEC=300
CLUSTER_DEAD_SEC=90
CLUSTER_STOP_USD=1.60
CLUSTER_MIN_M5_PCT=5.0
TRENCHES_MAX_PER_TICK=1
# JEV chair gate on cluster opens (1 = veto/avoid blocks the open,
# hold/buy proceeds; 0 = today's behavior). Blocked mints are not
# re-asked for JEV_CLUSTER_RECHECK_SEC.
JEV_CLUSTER_GATE=1
JEV_CLUSTER_RECHECK_SEC=300
# Same chair gate for the launch and create-event sniper entries
# (arb fills have their own veto-only gate — computed edge stands).
JEV_LAUNCH_GATE=1
JEV_SNIPER_GATE=1
# One sniper chair call per watch. Both lanes and later ticks reuse a
# proceed; vetoes still cool down for JEV_CLUSTER_RECHECK_SEC. 0 = SNIPER_WATCH_SEC.
JEV_SNIPER_PROCEED_SEC=0
# --- Dynamic per-token risk sizing (all trenches lanes) ---
# risk = base x safety x liquidity x conviction; size = risk / stop-fraction,
# so a full stop-out costs risk_usd by construction. Bases match today's
# implied risk (flat stop on flat size). 0 = flat size/stop (today's behavior).
SIZING_ENABLED=1
SIZING_RISK_CLUSTER_USD=1.60
SIZING_RISK_LAUNCH_USD=1.50
SIZING_RISK_COPY_USD=1.60
SIZING_RISK_SNIPE_USD=0.80
SIZING_MIN_RISK_USD=0.25
SIZING_MAX_RISK_USD=3.00
SIZING_STOP_BASE_PCT=4.0
SIZING_STOP_MIN_PCT=2.0
SIZING_STOP_MAX_PCT=15.0
SIZING_MIN_SIZE_USD=2.0
SIZING_MAX_SIZE_USD=80.0
SIZING_MAX_LIQ_FRAC=0.02
# Order-flow toxicity (VPIN-lite): refuse when recent swaps skew hard to
# sells with enough sample. Both sides come from the buyer screen's
# cached fetch, so this adds no Helius cost.
TOXICITY_GATE=1
TOX_MAX_SELL_FRAC=0.6
TOX_MIN_SWAPS=6
SWAPS_CACHE_SEC=30
# Exact on-chain curve reads (1 = verify reserves + completion via Helius
# before opens; 0 = Dex-anchored estimates only).
ONCHAIN_CURVE=1
CURVE_CACHE_SEC=300
# Bonding-curve guard on opens: refuse when our size moves the curve
# beyond this impact or dwarfs real pool depth (no RPC, pure math).
PUMP_CURVE_GUARD=1
PUMP_CURVE_MAX_IMPACT_PCT=10
PUMP_CURVE_MAX_LIQ_FRAC=0.05
# JEV exit monitor on open lots (1 = chair may force-exit a loser early).
# Each lot is re-asked at most every JEV_EXIT_RECHECK_SEC after
# JEV_EXIT_MIN_HOLD_SEC. Missed rugs cost more than early exits, so the
# threshold sits at 0.70 rather than higher.
JEV_EXIT_MONITOR=1
JEV_EXIT_THRESHOLD=0.70
JEV_EXIT_RECHECK_SEC=60
JEV_EXIT_MIN_HOLD_SEC=10
# Adverse slide that forces an immediate re-review (default 60s wait
# skipped): a $2 drop on a $40 lot gets judged at the next mark.
JEV_EXIT_PNL_DROP_USD=2.0
PAPER_STOP_GRACE_SEC=20
PAPER_ENTRY_CONFIRM_PCT=10
# Public create-event sniper: on — runs as an isolated lane book with
# Gate0 + JEV chair on every open (JEV_SNIPER_GATE).
SNIPER_ENABLED=1
SNIPER_INTERVAL_SEC=3
SNIPER_MAX_AGE_SEC=90
SNIPER_WATCH_SEC=45
SNIPER_MIN_BUYERS=4
SNIPER_MIN_LIFT_PCT=12
SNIPER_FAST_LIFT_PCT=25
SNIPER_MIN_REAL_SOL=10
SNIPER_MIN_LIQ_USD=1500
SNIPER_SIZE_USD=20
SNIPER_STOP_USD=0.80
SNIPER_TARGET_USD=1.0
SNIPER_TARGET_PCT=40
SNIPER_MAX_HOLD_SEC=45
SNIPER_DEAD_SEC=6
SNIPER_ABS_HOLD_SEC=90
SNIPER_MAX_PER_TICK=1
SNIPER_CURVE_DROP_PCT=50
SNIPER_LISTEN=1
SNIPER_MAX_CREATES_PER_HOUR=3
SNIPER_CREATOR_WINDOW_SEC=3600
# Optional: comma-separated wallets to copy as a cluster overlay.
CLUSTER_WALLETS=
# Copy-trading pilot: mirror tracked-leader buys into the isolated copy
# book. Needs COPY_MIN_LEADERS distinct leaders buying the mint inside
# COPY_WINDOW_SEC; entries then pass Gate 0, m5 bounds, and the chair.
COPY_ENABLED=1
COPY_MIN_LEADERS=1
COPY_WINDOW_SEC=120
COPY_SIZE_USD=40
COPY_MAX_HOLD_SEC=300
COPY_DEAD_SEC=90
COPY_STOP_USD=1.60
JEV_COPY_GATE=1

# --- Trading ---
LIVE_TRADING=0

# --- Phase 2: Sniper Mode Fast-Path ---
FAST_SNIPER_ENABLED=0

# Paper vs Dex/Gecko/Helius after each close. Does not size trades.
FILL_AUDIT_ENABLED=1
FILL_AUDIT_DELAY_SEC=20
FILL_AUDIT_HELIUS=1
FILL_AUDIT_HELIUS_LIMIT=20
