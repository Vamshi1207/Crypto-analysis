# Tracked paper/trading knobs. Commit this file.
# Secrets stay in gitignored .env (NVIDIA_KEY, GEMINI_API_KEY, HELIUS_API_KEY,
# SOLANA_RPC_URL, BIRDEYE_API_KEY). Docker loads .env.settings then .env.
# Do not put API keys or RPC URLs here.

# --- Ports ---
# Host port for python server on your Mac
HOST_PORT=8080

# Internal container port for python server
CONTAINER_PORT=8000

# Host port for Jupyter Notebook on your Mac
JUPYTER_PORT=8888

# --- LLM providers (keys in .env) ---
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
AGY_MODEL=gemini-3.1-pro-high

# --- Safety gate thresholds ---
SAFETY_MIN_LIQUIDITY_USD=5000
SAFETY_MAX_TOP10_PCT=55
SAFETY_MIN_POOL_AGE_MIN=5

# --- Execution cost model (shared by Gate 2 and paper fills) ---
# Slippage is the whole ballgame: at 1.5/1.0 a $1 target on $40 needs a 5.7%
# move in minutes, which almost never prints, so nothing ever trades. Jupiter's
# measured impact on small clips in $8k+ pools is well under 1%, and entry slip
# is replaced by that measurement whenever a quote is available — these are the
# fallbacks, so they should be realistic rather than punitive.
EXEC_ENTRY_FEE_PCT=0.3
EXEC_EXIT_FEE_PCT=0.3
EXEC_ENTRY_SLIP_PCT=0.6
EXEC_EXIT_SLIP_PCT=0.4
EXEC_PRIORITY_TIP_PCT=0.1

# --- Risk committee (Gate 3) ---
VIBE_BLOWOFF_RETURN_PCT=50
VIBE_EXTENDED_RETURN_PCT=20
VIBE_MIN_AGREEMENT=0.35

# --- Paper AutoHedge ---
# Take more paper trades so we see the real drawdown. Ignored if LIVE_TRADING=1.
PAPER_RISK_ON=1
# 0 = off / unlimited — entries follow decide analysis, not timers/quotas.
PAPER_REENTRY_COOLDOWN_SEC=0
PAPER_STOP_FILL_MODE=barrier
# Wider session loss budget on purpose: the point of paper is to find out what
# the drawdown actually looks like, and an 8% cutoff ends the run after ~26
# stops before there is a sample worth reading.
PAPER_MAX_LOSS_PCT=20
PAPER_MAX_TRADES_PER_MINT_DAY=0
PAPER_MAX_NOTIONAL_PER_MINT_DAY=0
PAPER_MAX_DAILY_LOSS_PER_MINT=12
PAPER_ALLOW_ADD_ON=1
PAPER_MAX_OPEN_LOTS_PER_ADDRESS=2
PAPER_BLOCK_ADD_ON_IF_OPEN_LOSING=1
PAPER_BLOCK_REPEAT_MINT_AFTER_STOP=0

# --- Position sizing / barriers ---
# Required move to bank the $1 target is (target/size + round-trip cost). At
# $40 that is 5.7%; at $150 with the cost model above it is ~2.4%, which
# memecoins print regularly. Size is the cheapest lever on tradability.
DECIDE_SCALP_SIZE_USD=150
DECIDE_TARGET_PROFIT_USD=1.0
PAPER_MAX_OPEN=10
PAPER_MAX_NOTIONAL_USD=900
# Percent-of-size stop: a flat $1.50 on a $150 clip is inside normal noise and
# would stop out before the setup resolves either way.
PAPER_STOP_LOSS_PCT=2.0
# Confidence scales size down; this floor stops it undoing the sizing above.
# At 0.75 a typical 0.35-confidence card still gets ~$112 rather than ~$49.
DECIDE_MIN_SIZE_FRACTION=0.75
# Let winners run past the target instead of always banking exactly $1.
PAPER_TRAIL_ENABLED=1
PAPER_TRAIL_ARM_USD=1.0
PAPER_TRAIL_GIVEBACK_PCT=0.5

# --- Scalp decide (Gate 2 paper uses 55% of $1 target until live) ---
PAPER_GATE2_EDGE_FRACTION=0.55
# Floor on cost-adjusted edge. Lowered from 0.5 to 0.1 for high-volume free tier practice.
DECIDE_MIN_EDGE_PCT=0.1

# --- Momentum entry (tape-based path around the forecast median) ---
MOMENTUM_ENTRY=1
MOMENTUM_THRUST_BARS=3
MOMENTUM_RANGE_BARS=20
MOMENTUM_MIN_THRUST_PCT=0.8
MOMENTUM_MIN_BREAKOUT_PCT=0.05
MOMENTUM_MIN_VOLUME_RATIO=1.15
MOMENTUM_MIN_BUY_SELL_RATIO=1.05
MOMENTUM_MAX_EXTENSION_PCT=25
MOMENTUM_MIN_SCORE=0.20

# --- Self-built candle feed (batched DexScreener prices) ---
# Gecko's keyless OHLCV quota caps the trade roster at whatever it serves before
# the first 429. Sampling prices ourselves keeps candles flowing for every name.
PRICEFEED_ENABLED=1
PRICEFEED_TICK_SEC=8
PRICEFEED_MAX_SAMPLES=720
PRICEFEED_MAX_TRACKED=80
PRICEFEED_BACKOFF_SEC=30

# --- Headless discovery ---
DISCOVER_ENABLED=1
DISCOVER_INTERVAL_SEC=120
DISCOVER_MAX_CANDIDATES=36
DISCOVER_MAX_OBSERVE=40
DISCOVER_MIN_LIQUIDITY_USD=8000
DISCOVER_MIN_VOLUME_24H_USD=10000
DISCOVER_MIN_AGE_MIN=2
DISCOVER_MAX_AGE_DAYS=30
DISCOVER_NO_EDGE_STREAK=2
# 0 = never time-park; keep re-checking when analysis might flip
DISCOVER_NO_EDGE_COOLDOWN_SEC=0
DISCOVER_EXPLORE_MULTIPLIER=6
# Extra Gecko pool listings beyond trending — new_pools is where memecoin moves
# start, and one feed alone left the roster far too narrow to get a sample.
DISCOVER_GECKO_FEEDS=new_pools,pools
DISCOVER_PRICEFEED_MIN_BARS=12

# --- Decision swarm (continuous decide → paper) ---
SWARM_ENABLED=1
SWARM_INTERVAL_SEC=60
SWARM_MODE=fast
SWARM_DECIDE_OBSERVE=1
SWARM_RUN_SAFETY=0

# --- Paper cross-pool arb ---
ARB_ENABLED=1
ARB_INTERVAL_SEC=30
ARB_MIN_EDGE_PCT=0.05
# Dex mids are a screen. The fill is Jupiter SOL→mint→SOL (circular), hops allowed.
ARB_PREFILTER_MODE=jupiter
ARB_SCREEN_GROSS_PCT=0.3
ARB_MIN_POOL_LIQ_USD=8000
ARB_SIZE_USD=40
ARB_MIN_SIZE_USD=10
ARB_MAX_POOL_FRAC=0.005
ARB_MAX_PER_TICK=3
# 0 = off — re-enter whenever stress/Jupiter analysis still clears
ARB_MINT_COOLDOWN_SEC=0
ARB_MAX_FILLS_PER_MINT_DAY=0
ARB_REQUIRE_CROSS_DEX=0
ARB_STRESS_GAP_FRAC=0.5
ARB_SLIP_PCT=0
ARB_REQUIRE_JUPITER=1
ARB_REQUIRE_BUY_ROUTE=1
ARB_MAX_JUPITER_IMPACT_PCT=8
ARB_JUPITER_IMPACT_LEGS=2
ARB_SOL_USD_FALLBACK=140
ARB_CIRCULAR=1
ARB_MAX_CIRCULAR_PER_TICK=4
ARB_JUPITER_GAP_SEC=0.4
ARB_RESTRICT_INTERMEDIATE=0

# --- Live readiness bars (paper must clear before LIVE_TRADING) ---
READY_MIN_SCALP_CLOSES=50
READY_MIN_ARB_FILLS=30
READY_MIN_DECISIONS=200
READY_MIN_SCOREBOARD_N=30
READY_MIN_SCALP_EV_USD=0
READY_MIN_ARB_EV_USD=0
READY_MIN_COVERAGE=0.55
READY_MAX_MAE=8

# --- Indicator alignment (after Gate 2) ---
INDICATOR_GATE=0
INDICATOR_MIN_BUY_SCORE=-0.15
INDICATOR_HARD_BLOCK_SCORE=-0.45

# --- Pipeline observability ---
PIPELINE_LOG_JSONL=1
PIPELINE_LOG_CONSOLE=1
PIPELINE_LOG_LEVEL=INFO
PIPELINE_LOG_HOLDS=0

# Parallel paper books: same tape, isolated cash, different rules.
LABS_ENABLED=1

# --- Launch + smart-money cluster (paper) ---
LAUNCH_ENABLED=0
CLUSTER_ENABLED=1
TRENCHES_INTERVAL_SEC=15
LAUNCH_MAX_AGE_MIN=12
LAUNCH_MIN_LIQ_USD=8000
LAUNCH_MIN_BUYERS=2
LAUNCH_SIZE_USD=80
LAUNCH_MAX_HOLD_SEC=180
TRENCHES_MAX_PRICE_DIVERGE_PCT=8
CLUSTER_MIN_WALLETS=3
CLUSTER_WINDOW_SEC=90
CLUSTER_SIZE_USD=80
CLUSTER_MAX_HOLD_SEC=300
TRENCHES_MAX_PER_TICK=1
PAPER_STOP_GRACE_SEC=12
PAPER_ENTRY_CONFIRM_PCT=8
# Public create-event sniper: Gecko new_pools age in seconds, $1 and out.
SNIPER_ENABLED=1
SNIPER_INTERVAL_SEC=3
SNIPER_MAX_AGE_SEC=90
SNIPER_WATCH_SEC=45
SNIPER_MIN_BUYERS=4
SNIPER_MIN_LIFT_PCT=12
SNIPER_FAST_LIFT_PCT=25
SNIPER_MIN_REAL_SOL=10
SNIPER_MIN_LIQ_USD=1500
SNIPER_SIZE_USD=20
SNIPER_STOP_USD=0.80
SNIPER_TARGET_USD=1.0
SNIPER_TARGET_PCT=40
SNIPER_MAX_HOLD_SEC=45
SNIPER_DEAD_SEC=6
SNIPER_ABS_HOLD_SEC=90
SNIPER_MAX_PER_TICK=1
SNIPER_CURVE_DROP_PCT=50
SNIPER_LISTEN=1
SNIPER_MAX_CREATES_PER_HOUR=3
SNIPER_CREATOR_WINDOW_SEC=3600
# Optional: comma-separated wallets to copy as a cluster overlay.
CLUSTER_WALLETS=

# --- Trading ---
LIVE_TRADING=0

# --- Phase 2: Sniper Mode Fast-Path ---
FAST_SNIPER_ENABLED=0

# Paper vs Dex/Gecko/Helius after each close. Does not size trades.
FILL_AUDIT_ENABLED=1
FILL_AUDIT_DELAY_SEC=20
FILL_AUDIT_HELIUS=1
FILL_AUDIT_HELIUS_LIMIT=20
