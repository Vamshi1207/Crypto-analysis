# Gitignored secrets. Copy to .env and fill in keys:
#   cp .env.example .env
# Paper/trading knobs are tracked in .env.settings — do not paste them here.
# Docker loads .env.settings first, then .env (this file wins on duplicate keys).

# NVIDIA hosted Nemotron
NVIDIA_KEY=

# Antigravity CLI (agy). Leave blank unless you use a Google AI key.
GEMINI_API_KEY=

# JEV System One chair (typed decisions, Gate 3). Leave blank unless enabled.
# Native TypeSafe key for https://api.typesafe.ai/v1/systemone ...
TYPESAFE_API_KEY=
# ... or Jevx proxy key for https://jevx.org/api/v1/decisions (set JEV_ENDPOINT).
JEVX_API_KEY=

# Helius free tier. Comma-separated keys rotate on HTTP 429 / WS reject.
# Example: HELIUS_API_KEY=uuid-one,uuid-two,uuid-three
HELIUS_API_KEY=
# Optional paid/dedicated RPC (URL may embed a key).
SOLANA_RPC_URL=
# Birdeye free tier. Optional cross-check.
BIRDEYE_API_KEY=
