# Gitignored secrets. Copy to .env and fill in keys:
#   cp .env.example .env
# Paper/trading knobs are tracked in .env.settings — do not paste them here.
# Docker loads .env.settings first, then .env (this file wins on duplicate keys).

# NVIDIA hosted Nemotron
NVIDIA_KEY=

# Antigravity CLI (agy). Leave blank unless you use a Google AI key.
GEMINI_API_KEY=

# Helius free tier: 1M credits/mo. Blank falls back to public Solana RPC.
HELIUS_API_KEY=
# Optional paid/dedicated RPC (URL may embed a key).
SOLANA_RPC_URL=
# Birdeye free tier. Optional cross-check.
BIRDEYE_API_KEY=
