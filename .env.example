# --- Ports ---
# Host port for python server
HOST_PORT=8080
# Internal container port for python server
CONTAINER_PORT=8000
# Host port for Jupyter Notebook
JUPYTER_PORT=8888

# --- LLM providers ---
# NVIDIA hosted Nemotron (free trial tier, ~40 req/min)
NVIDIA_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Local fallback
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Antigravity CLI (agy) — replaces deprecated Gemini CLI.
# Leave blank for account default, or set a slug from `agy models`.
# Deep-review default: gemini-3.1-pro-high
# One-time login: docker compose exec python_server agy
AGY_MODEL=gemini-3.1-pro-high
GEMINI_API_KEY=

# --- Solana data sources ---
# Helius free tier: 1M credits/mo, 10 rps. Leave blank to use the public RPC.
HELIUS_API_KEY=
SOLANA_RPC_URL=
# Birdeye free tier: 30K CU/mo, 1 rps. Optional cross-check.
BIRDEYE_API_KEY=

# --- Safety gate thresholds ---
SAFETY_MIN_LIQUIDITY_USD=5000
SAFETY_MAX_TOP10_PCT=55
SAFETY_MIN_POOL_AGE_MIN=5

# --- Scalp decide (buy fast / sell fast, ~$1 net target) ---
# Gate 1 history floor aligns with forecast (≥16 bars). Prefer 5S/15S when young.
DECIDE_MIN_HISTORY_BARS=16
# Required move to bank the target is (target/size + round-trip cost). At $40
# that is ~5.7%, which is why nothing traded; at $150 it is ~2.4%.
DECIDE_SCALP_SIZE_USD=150
DECIDE_TARGET_PROFIT_USD=1
# Paper-only: Gate 2 uses this fraction of target ($1 → $0.55). Live uses 1.0.
PAPER_GATE2_EDGE_FRACTION=0.55
# Floor on cost-adjusted edge. Keep below the target's implied edge or this
# floor, not the profit target, becomes the binding constraint.
DECIDE_MIN_EDGE_PCT=0.5
DECIDE_MAX_SLIPPAGE_BPS=1200
DECIDE_MIN_LIQUIDITY_USD=1000
DECIDE_HORIZON_BARS=6

# --- Execution cost model (shared by Gate 2 and paper fills) ---
# These must reflect reality: a driftless barrier scalp returns minus the
# round-trip cost, so this is the hurdle any forecast edge has to clear.
# Entry slip is replaced by Jupiter's measured impact when a quote exists, so
# these are fallbacks — punitive defaults make every trade look unprofitable.
EXEC_ENTRY_FEE_PCT=0.3
EXEC_EXIT_FEE_PCT=0.3
EXEC_ENTRY_SLIP_PCT=0.6
EXEC_EXIT_SLIP_PCT=0.4
EXEC_PRIORITY_TIP_PCT=0.1

# --- Risk committee (Gate 3) ---
# Fade near-vertical moves instead of joining them; window return in percent.
VIBE_BLOWOFF_RETURN_PCT=50
VIBE_EXTENDED_RETURN_PCT=20
# Veto buys when the forecast ensemble disagrees this much (0-1, 1 = agreement).
VIBE_MIN_AGREEMENT=0.35

# --- Paper AutoHedge (Phase 4) ---
# Take more paper trades so the session produces a real risk sample.
# Forced off when LIVE_TRADING=1.
PAPER_RISK_ON=1
PAPER_MAX_OPEN=5
PAPER_MAX_NOTIONAL_USD=200
PAPER_STOP_LOSS_USD=1.5
PAPER_MAX_HOLD_SEC=600
# Quiet period after a close before the same token may be re-entered.
# 0 = off — if decide still sees edge, paper may re-buy immediately.
PAPER_REENTRY_COOLDOWN_SEC=0
# barrier = fill stop at $-stop (no gap blowout); mark = live-like gaps + max-loss clamp
PAPER_STOP_FILL_MODE=barrier
PAPER_MAX_LOSS_PCT=20
PAPER_MAX_OPEN=4
PAPER_MAX_NOTIONAL_USD=600
# Percent-of-size stop (0 = use the flat PAPER_STOP_LOSS_USD instead). A flat
# dollar stop on a larger clip sits inside normal noise.
PAPER_STOP_LOSS_PCT=2.0
# Floor on the confidence multiplier applied to size. Because the target is a
# fixed dollar amount, sizing down raises the percent move the trade must catch.
DECIDE_MIN_SIZE_FRACTION=0.75
# Trailing take-profit: arm at this profit, then bank when the position gives
# back the larger of PAPER_TRAIL_GIVEBACK_PCT of size or
# PAPER_TRAIL_GIVEBACK_OF_PEAK of the peak. A single Dex print that jumps more
# than PAPER_TRAIL_MAX_JUMP_PCT of size is ignored (ghost mids used to arm the
# trail and then "take profit" at a loss).
PAPER_TRAIL_ENABLED=1
PAPER_TRAIL_ARM_USD=1.0
PAPER_TRAIL_GIVEBACK_PCT=0.5
PAPER_TRAIL_GIVEBACK_OF_PEAK=0.35
PAPER_TRAIL_MAX_JUMP_PCT=15
# Concentration: 0 = unlimited (analysis / cash decide). Daily loss cap still applies.
PAPER_MAX_TRADES_PER_MINT_DAY=0
PAPER_MAX_NOTIONAL_PER_MINT_DAY=0
PAPER_MAX_DAILY_LOSS_PER_MINT=5
# If decide still sees edge on a coin you already hold, open another lot (each
# keeps its own ~$1 take-profit / stop). Bound by cash + PAPER_MAX_OPEN / notional.
PAPER_ALLOW_ADD_ON=1
PAPER_MAX_OPEN_LOTS_PER_ADDRESS=2
PAPER_BLOCK_ADD_ON_IF_OPEN_LOSING=1
PAPER_BLOCK_REPEAT_MINT_AFTER_STOP=1
PAPER_KILL_SWITCH=0

# --- Headless discovery (DexScreener boosts + Gecko trending → paper swarm) ---
DISCOVER_ENABLED=0
DISCOVER_INTERVAL_SEC=45
# Trade roster (full Gate 0 + swarm decide). Observe fills dashboard volume.
DISCOVER_MAX_CANDIDATES=36
DISCOVER_MAX_OBSERVE=40
DISCOVER_MIN_LIQUIDITY_USD=8000
DISCOVER_MIN_VOLUME_24H_USD=10000
DISCOVER_MIN_AGE_MIN=20
DISCOVER_MAX_AGE_DAYS=21
# Rotate soft-signal after repeated Gate-2 fails; 0 cooldown = keep re-evaluating.
DISCOVER_NO_EDGE_STREAK=2
DISCOVER_NO_EDGE_COOLDOWN_SEC=0
DISCOVER_EXPLORE_MULTIPLIER=6
# Extra Gecko pool listings beyond trending (comma separated: new_pools, pools).
DISCOVER_GECKO_FEEDS=new_pools,pools
# Sampled bars required before the price feed may hydrate a trade-roster token.
DISCOVER_PRICEFEED_MIN_BARS=18

# --- Self-built candle feed (batched DexScreener prices) ---
# Gecko's keyless OHLCV quota caps the trade roster at whatever it serves before
# the first 429, so sampling prices ourselves is what keeps the roster full.
PRICEFEED_ENABLED=1
PRICEFEED_TICK_SEC=8
PRICEFEED_MAX_SAMPLES=720
PRICEFEED_MAX_TRACKED=60
# Discovery shares this rate limit, so a 429 pauses sampling rather than retrying.
PRICEFEED_BACKOFF_SEC=30

# --- Momentum entry (tape-based path around the forecast median) ---
# A breakout on expanding volume is evidence the conformal median cannot see, so
# it gets its own route through Gate 2. Strict on purpose: it bypasses the edge
# hurdle, so several independent conditions must agree.
MOMENTUM_ENTRY=1
MOMENTUM_THRUST_BARS=3
MOMENTUM_RANGE_BARS=20
MOMENTUM_MIN_THRUST_PCT=0.8
MOMENTUM_MIN_BREAKOUT_PCT=0.05
MOMENTUM_MIN_VOLUME_RATIO=1.15
MOMENTUM_MIN_BUY_SELL_RATIO=1.05
MOMENTUM_MAX_EXTENSION_PCT=25
MOMENTUM_MIN_SCORE=0.45

# --- Decision swarm (continuous decide → paper) ---
SWARM_ENABLED=0
SWARM_INTERVAL_SEC=12
SWARM_MODE=fast
SWARM_DECIDE_OBSERVE=1
# 0 = skip repeating Gate 0 every swarm tick (discover already screened).
SWARM_RUN_SAFETY=0

# --- Paper cross-pool arb (parallel channel; no live swaps) ---
ARB_ENABLED=0
ARB_INTERVAL_SEC=8
ARB_MIN_EDGE_PCT=0.05
# stress = require the halved Dex gap to clear the hurdle before spending a
# quote (safe, but rejects nearly everything so the channel learns nothing).
# jupiter = treat the Dex gap as a screen and let the executable round-trip
# quote decide, which is strictly better evidence than two pool mids.
ARB_PREFILTER_MODE=jupiter
ARB_SCREEN_GROSS_PCT=0.3
ARB_MIN_POOL_LIQ_USD=8000
ARB_SIZE_USD=40
# Floor after liquidity cap; skips if thinner pool cannot support this size.
ARB_MIN_SIZE_USD=10
# Cap size at this fraction of the thinner pool (0.5% of $8k = $40).
ARB_MAX_POOL_FRAC=0.005
ARB_MAX_PER_TICK=3
# After a paper fill: 0 = off (analysis may re-enter immediately).
ARB_MINT_COOLDOWN_SEC=0
# Max paper fills per mint/day: 0 = unlimited.
ARB_MAX_FILLS_PER_MINT_DAY=0
# 0 = also quote same-DEX pool gaps (Jupiter still has to clear).
ARB_REQUIRE_CROSS_DEX=0
# Only fill if (gross_spread * this − costs) still clears ARB_MIN_EDGE_PCT.
# Booked PnL uses this stressed net (minus Jupiter impact), not the raw gap.
ARB_STRESS_GAP_FRAC=0.5
# Skip Dex gaps above this % — stale/wrong pool prices can print 1000x+ noise.
ARB_MAX_GROSS_PCT=50
# 0 = use EXEC_* slip; set e.g. 0.5 to assume tighter arb fills
ARB_SLIP_PCT=0
# Require Jupiter routes + impact check before booking paper arb PnL
ARB_REQUIRE_JUPITER=1
ARB_REQUIRE_BUY_ROUTE=1
ARB_MAX_JUPITER_IMPACT_PCT=8
# If only sell impact is known, multiply by this for round-trip haircut.
ARB_JUPITER_IMPACT_LEGS=2
ARB_SOL_USD_FALLBACK=140
# Jupiter SOL→mint→SOL on seeds + discover, hops allowed.
ARB_CIRCULAR=1
ARB_MAX_CIRCULAR_PER_TICK=4
ARB_RESTRICT_INTERMEDIATE=0
ARB_JUPITER_GAP_SEC=0.4

# --- Live readiness (GET /readiness) — paper must clear before LIVE_TRADING ---
READY_MIN_SCALP_CLOSES=50
READY_MIN_ARB_FILLS=30
READY_MIN_DECISIONS=200
READY_MIN_SCOREBOARD_N=30
READY_MIN_SCALP_EV_USD=0
READY_MIN_ARB_EV_USD=0
READY_MIN_COVERAGE=0.55
READY_MAX_MAE=8

# --- Indicator alignment (after Gate 2 edge clears) ---
INDICATOR_GATE=1
INDICATOR_MIN_BUY_SCORE=-0.15
INDICATOR_HARD_BLOCK_SCORE=-0.45

# --- Faster data (optional paid) ---
# Helius paid unlocks better RPC + websockets (sub-second marks / Geyser).
# Jito only matters when LIVE_TRADING=1 for bundles — unused in paper.
# BIRDEYE_API_KEY= optional denser OHLCV (free tier ~1 rps)

# --- Pipeline observability ---
PIPELINE_LOG_JSONL=1
PIPELINE_LOG_CONSOLE=1
PIPELINE_LOG_LEVEL=INFO
PIPELINE_LOG_HOLDS=1

# --- Launch + smart-money cluster (paper only) ---
# Public events: new Gecko pools + unique-buyer clusters via Helius.
LAUNCH_ENABLED=1
CLUSTER_ENABLED=1
TRENCHES_INTERVAL_SEC=15
LAUNCH_MAX_AGE_MIN=12
LAUNCH_MIN_LIQ_USD=8000
LAUNCH_MIN_BUYERS=2
LAUNCH_SIZE_USD=80
LAUNCH_MAX_HOLD_SEC=180
# Skip paper fills when Gecko and Dex disagree by more than this percent.
TRENCHES_MAX_PRICE_DIVERGE_PCT=8
CLUSTER_MIN_WALLETS=3
CLUSTER_WINDOW_SEC=90
CLUSTER_SIZE_USD=80
CLUSTER_MAX_HOLD_SEC=300
TRENCHES_MAX_PER_TICK=1
# Launch/cluster only: ignore a first-tick venue gap for this many seconds.
PAPER_STOP_GRACE_SEC=12
PAPER_ENTRY_CONFIRM_PCT=8
# Paper sniper: watch landed Pump creates, buy only if the curve tape lifts.
SNIPER_ENABLED=1
SNIPER_INTERVAL_SEC=3
SNIPER_MAX_AGE_SEC=90
SNIPER_WATCH_SEC=45
SNIPER_MIN_BUYERS=2
SNIPER_MIN_LIFT_PCT=5
SNIPER_FAST_LIFT_PCT=12
SNIPER_MIN_REAL_SOL=2.5
SNIPER_MIN_LIQ_USD=1500
SNIPER_SIZE_USD=40
SNIPER_TARGET_USD=1.0
SNIPER_TARGET_PCT=40
SNIPER_MAX_HOLD_SEC=45
SNIPER_DEAD_SEC=6
SNIPER_ABS_HOLD_SEC=90
SNIPER_MAX_PER_TICK=1
SNIPER_CURVE_DROP_PCT=50
# Helius logsSubscribe on Pump.fun Create/Trade (landed txs only).
SNIPER_LISTEN=1
SNIPER_MAX_CREATES_PER_HOUR=3
SNIPER_CREATOR_WINDOW_SEC=3600
# Optional watchlist (comma-separated). Cluster also counts unique buyers on the mint.
CLUSTER_WALLETS=

# --- Trading ---
# Never set to 1 until paper results are reviewed
LIVE_TRADING=0
